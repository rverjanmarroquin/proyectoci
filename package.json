{
  "name": "restaurante-api",
  "version": "1.0.0",
  "description": "Sistema basico de reservas para restaurante (proyecto integrador CI/CD)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node --check src/server.js && node --check src/app.js && node --check src/reservasService.js",
    "lint": "eslint .",
    "test": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/repo/pgRepo.js"],
    "coverageReporters": ["text", "lcov"],
    "coverageThreshold": { "global": { "lines": 80, "statements": 80, "functions": 80, "branches": 70 } },
    "reporters": ["default", "jest-junit"]
  },
  "jest-junit": { "outputDirectory": "reports", "outputName": "junit.xml" }
}
